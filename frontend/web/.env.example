# Server-only API origin. Requests stay same-origin in the browser.
API_URL=http://127.0.0.1:8000
# Optional public origin for a separately hosted API (requires backend CORS).
NEXT_PUBLIC_API_URL=
# Optional Neon Auth browser endpoint. Empty uses the API's account routes.
# API accounts require LEGACYLIFT_TOKEN_SECRET on the backend.
NEXT_PUBLIC_NEON_AUTH_URL=

