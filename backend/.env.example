# Copy to backend/.env to change settings; the API reads that file at startup.
# Real environment variables override it. Every setting is optional.

# Extra frontend origins allowed to call the API, comma-separated.
# Local Vite and https://aadituh.github.io are always allowed.
LEGACYLIFT_CORS_ORIGINS=https://example.com

# Folder where each project is saved as <id>.json when DATABASE_URL is unset.
LEGACYLIFT_DATA_DIR=data/projects

# How many projects to keep; the oldest is deleted first.
LEGACYLIFT_MAX_PROJECTS=100

# Largest request body in bytes; bigger requests get 413.
LEGACYLIFT_MAX_REQUEST_BYTES=1200000

# HMAC secret for login tokens. Set the real value here and on the Render API
# service. Git ignores backend/.env. Never commit the secret.
# LEGACYLIFT_TOKEN_SECRET=
# How long a login token stays valid, in seconds. 86400 is 24 hours.
# LEGACYLIFT_TOKEN_TTL_SECONDS=86400
# Leave false until every project route must reject anonymous callers.
# true makes /api/projects require Authorization: Bearer <token>.
# LEGACYLIFT_REQUIRE_LOGIN=false
# Neon Auth base URL. A Bearer token from the web app (authClient.token()) is
# checked against {this URL}/.well-known/jwks.json. The sub claim is stored as
# projects.owner_id. Defaults to this project's Neon Auth URL.
# LEGACYLIFT_NEON_AUTH_URL=https://ep-jolly-tree-b5ygfgag.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth

# Let POST /api/projects/{id}/verify run COBOL and Python in the runner container.
# Off by default. docker compose up turns it on and sets the URL.
# LEGACYLIFT_ENABLE_RUNNER=true
# LEGACYLIFT_RUNNER_URL=http://localhost:8001

# Gemini API key for POST /api/projects/{id}/describe and
# POST /api/projects/{id}/ai-review (model gemini-3.5-flash-lite).
# Create one at https://aistudio.google.com/apikey
# Put the real key in backend/.env, which git ignores. Never commit it.
# With docker compose, put it in .env at the repository root instead.
# LEGACYLIFT_GEMINI_API_KEY=
# How long one Gemini request may wait, in seconds.
# LEGACYLIFT_GEMINI_TIMEOUT_SECONDS=30

# Neon connection string. When set, projects, files, and runs are stored in
# Postgres (database/schema.sql) instead of LEGACYLIFT_DATA_DIR.
# In Neon, open Connect and copy the connection string. Keep the real value
# in backend/.env, which git ignores.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require
