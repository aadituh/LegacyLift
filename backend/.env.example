# Copy to backend/.env to change settings; the API reads that file at startup.
# Real environment variables override it. Every setting is optional.

# Extra frontend origins allowed to call the API, comma-separated.
# Local Vite and https://aadituh.github.io are always allowed.
LEGACYLIFT_CORS_ORIGINS=https://example.com

# Folder where each project is saved as <id>.json (relative to backend/).
LEGACYLIFT_DATA_DIR=data/projects

# How many projects to keep; the oldest is deleted first.
LEGACYLIFT_MAX_PROJECTS=100

# Largest request body in bytes; bigger requests get 413.
LEGACYLIFT_MAX_REQUEST_BYTES=1200000
