# Optional CORS setting for a separately hosted frontend.
# Set this as an environment variable before starting Uvicorn.
# The backend does not automatically load this file.
LEGACYLIFT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://aadituh.github.io

# Neon PostgreSQL. In the Neon dashboard, open Connect and copy the connection string.
# Use the direct host (no "-pooler" in the hostname) for Alembic.
# Replace the placeholders. Keep the real string in backend/.env, which git ignores.
# If the password contains @ : / # or ?, URL-encode it.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require
